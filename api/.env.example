# Saladee API — environment template (D-11 / Phase-2 additions).
# Copy to `.env` (gitignored) and fill in real values for local dev.
# Prod values live in GitHub Actions Secrets, injected onto the VPS at deploy.
# Every non-defaulted variable below is REQUIRED at boot (api/src/env.ts fails fast).

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL
#   DATABASE_URL        — runtime queries. Prod: Neon POOLED (-pooler) endpoint.
#   DATABASE_URL_DIRECT — migrations + pg-boss. Prod: Neon DIRECT (unpooled) endpoint.
DATABASE_URL=postgres://saladee:saladee@localhost:5432/saladee
DATABASE_URL_DIRECT=postgres://saladee:saladee@localhost:5432/saladee

# LINE Messaging API channel (webhook signature + reply)
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# LINE Login channel id — used as the `aud` when verifying idTokens
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id

# Session signing — MUST be at least 32 characters
JWT_SECRET=change-me-to-a-32char-min-random-secret

# Cloudflare R2 (private bucket for slips/photos)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=saladee-uploads
# Public base URL for PRODUCT-IMAGE marketing assets (D-26, 04-11 / ORD-05).
# Product photos are PUBLIC (unlike private signed-URL slips): the web-admin upload
# stores `${R2_PUBLIC_BASE_URL}/${key}` in variety_images/box_images so the store,
# LIFF and Flex render them directly. Set this to your R2 public bucket domain or a
# custom domain, e.g. https://img.yourshop.com (NO trailing slash — it is stripped).
# Operator note: the URL is baked in AT UPLOAD TIME. Photos uploaded while this was
# empty are stored as bare key paths (/product-images/...) that 404 in the store —
# after setting this, re-upload those photos (or backfill the stored rows) so their
# URLs become absolute. Leave empty ("") only for local dev/test where the key path
# alone is acceptable; provision the real public base per shop in prod.
R2_PUBLIC_BASE_URL=

# ── Phase-2 payments / slip-verify / hold ────────────────────────────────────
# Slip-verification adapter (02-06). SLIPOK_* default to "" until provisioned;
# NEVER commit real values — set them in .env / GitHub Secrets only.
SLIP_VERIFY_PROVIDER=slipok
SLIPOK_BRANCH_ID=your-slipok-branch-id
SLIPOK_API_KEY=your-slipok-api-key
# PromptPay payee (phone "0812345678" or 13-digit national id) — REQUIRED, no default.
PROMPTPAY_PAYEE_ID=0812345678
# QR hold window before an unpaid order is auto-cancelled (seconds). 30 min default.
HOLD_WINDOW_SECONDS=1800
