JWT_SECRET=0123456789abcdef0123456789abcdef
R2_ACCOUNT_ID=test-account
R2_ACCESS_KEY_ID=test-access-key-id
R2_SECRET_ACCESS_KEY=test-secret-access-key
R2_BUCKET=saladee-uploads-test
