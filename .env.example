# Saladee API — environment template (D-11).
# Copy to `.env` (gitignored) and fill in real values for local dev.
# Prod values live in GitHub Actions Secrets, injected onto the VPS at deploy.
# Every variable below is REQUIRED at boot (api/src/env.ts fails fast if missing).

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL
#   DATABASE_URL        — runtime queries. Prod: Neon POOLED (-pooler) endpoint.
#   DATABASE_URL_DIRECT — migrations. Prod: Neon DIRECT (unpooled) endpoint.
DATABASE_URL=postgres://saladee:saladee@localhost:5432/saladee
DATABASE_URL_DIRECT=postgres://saladee:saladee@localhost:5432/saladee

# LINE Messaging API channel (webhook signature + reply)
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# LINE Login channel id — used as the `aud` when verifying idTokens
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id

# Session signing — MUST be at least 32 characters
JWT_SECRET=change-me-to-a-32char-min-random-secret

# Cloudflare R2 (private bucket for slips/photos)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=saladee-uploads
