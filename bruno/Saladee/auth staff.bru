meta {
  name: auth staff
  type: http
  seq: 5
}

post {
  url: {{URL}}/auth/staff
  body: json
  auth: none
}

body:json {
  {
    "email": "owner@saladee.local",
    "password": "SaladeeOwner2026!"
  }
}

script:post-response {
  // Capture the staff session token so the admin-seed requests can reuse it.
  if (res.status === 200 && res.body && res.body.token) {
    bru.setEnvVar("TOKEN", res.body.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
